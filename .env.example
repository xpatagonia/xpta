# ==============================================================================
# FASE 1 — PRODUCCIÓN ACTUAL (Cloud / Cloudflare Pages + Supabase + CyberPanel)
# ==============================================================================

# URL de la app (inyectada en runtime o definida en producción)
APP_URL=https://xpatagonia.online

# Frontend (Vite / Cloudflare Pages)
VITE_API_URL=
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# Backend Node (server.ts)
PORT=3000
NODE_ENV=production
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_POOLER_HOST=
SUPABASE_POOLER_PORT=6543
ADMIN_EMAILS=xpatagonia.com@gmail.com
GEMINI_API_KEY=
CRON_SECRET=
GOOGLE_MAPS_PLATFORM_KEY=

# Correo Saliente Transaccional (Resend HTTPS — recomendado en Cloud/AI Studio)
RESEND_API_KEY=
RESEND_FROM_EMAIL="xPatagonia <notificaciones@xpatagonia.online>"

# Correo Corporativo Entrante / Fallback SMTP (Cloud VPS CyberPanel)
IMAP_HOST=mail.xpatagonia.online
IMAP_PORT=993
IMAP_USER=notificaciones@xpatagonia.online
IMAP_PASSWORD=
SMTP_HOST=mail.xpatagonia.online
SMTP_PORT=465
SMTP_USER=notificaciones@xpatagonia.online
SMTP_PASSWORD=

# ==============================================================================
# FASE FINAL — INFRAESTRUCTURA PROPIA SUPERMICRO PROXMOX (infra/docker-compose)
# Nota: Dejar vacío hasta desplegar el servidor Supermicro al cierre del proyecto.
#       Sin estas variables, logística usa router.project-osrm.org y n8n encola local.
# ==============================================================================
VITE_OSRM_URL=
VITE_N8N_WEBHOOK_URL=
OSRM_BASE_URL=
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=
ODOO_WEBHOOK_SECRET=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
CLOUDFLARE_TUNNEL_TOKEN=
